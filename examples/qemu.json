{
  "name": "qemu-ephemeral",
  "backend": "qemu",
  "image": "/var/lib/ephemera/images/ubuntu.qcow2",
  "vcpus": 2,
  "memory_mib": 2048,
  "disk_size_gib": 20,
  "network": {
    "mode": "user",
    "forwards": [{"host_port": 2222, "guest_port": 22, "protocol": "tcp"}]
  },
  "cloud_init": {
    "hostname": "qemu-ephemeral",
    "user": "zyvor",
    "ssh_authorized_keys": ["ssh-ed25519 REPLACE_ME"],
    "packages": ["curl", "jq"],
    "runcmd": ["echo ready > /tmp/ready"]
  },
  "ttl_seconds": 900
}
