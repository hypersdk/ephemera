[Unit]
Description=Zyvor Ephemera control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ephemera --config /etc/ephemera.toml serve
Restart=on-failure
RestartSec=2
# TAP creation needs CAP_NET_ADMIN. KVM needs /dev/kvm access.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ephemera /run/ephemera

[Install]
WantedBy=multi-user.target
