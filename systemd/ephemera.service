[Unit]
Description=Zyvor Ephemera control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ephemera --config /etc/ephemera.toml serve
Restart=on-failure
RestartSec=2
# Default KillMode (control-group) would SIGTERM every QEMU child process
# along with ephemera itself on every restart/upgrade, killing every
# running VM. `reconcile()` (ephemera-scheduler) is explicitly designed to
# reattach to an already-running VM by checking its stored PID is still
# alive, not by re-launching it -- so a bare `process` KillMode (only the
# tracked ExecStart PID, QEMU children left alone) is exactly what lets a
# binary upgrade/restart happen without disrupting live VMs.
KillMode=process
# TAP creation needs CAP_NET_ADMIN. KVM needs /dev/kvm access. Disk
# provisioning (cloud-init/agent injection via guestfs) attaches the image
# through /dev/nbd*, which needs CAP_SYS_ADMIN for the NBD_SET_SOCK ioctl.
# CAP_NET_BIND_SERVICE + CAP_NET_RAW: the per-VM-namespace dnsmasq DHCP
# server (see ephemera_network::netns) binds UDP/67 (a privileged port) and
# needs raw sockets for its own DHCP internals -- found live, one at a
# time: first "Permission denied" binding :67, then (after adding
# NET_BIND_SERVICE) "process is missing required capability NET_RAW".
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# guestkit (disk customization/agent-token injection) needs a scratch mount
# root under /run or /tmp; PrivateTmp gives it an isolated, writable /tmp
# without opening up the host's shared one.
PrivateTmp=true
# /run/netns: per-VM network namespaces (NetworkSpec::Tap { netns: true })
# persist as bind-mount targets there -- the standard iproute2/kernel
# location, not something ephemera can relocate.
ReadWritePaths=/var/lib/ephemera /run/ephemera /var/lock /run/netns

[Install]
WantedBy=multi-user.target
